meta {
  name: Consultar movimientos de inventario -> 200
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/inventory/{{inventarioId}}/movements?page=1&limit=20
  auth: bearer
}

headers {
  Authorization: Bearer {{tokenWarehouse}}
}

auth:bearer {
  token: {{tokenWarehouse}}
}

assert {
  res.status: eq 200
  res.body.inventario.inventario_id: isDefined
  res.body.data: isArray
  res.body.data[0].tipo_movimiento: eq AJUSTE_SALIDA
}