meta {
  name: Ajuste ENTRADA WAREHOUSE -> 201
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/inventory/adjustments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenWarehouse}}
}

auth:bearer {
  token: {{tokenWarehouse}}
}

body:json {
  {
    "productId": 3,
    "tipo": "ENTRADA",
    "cantidad": 4,
    "motivo": "Bruno: recepción de inventario"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("inventarioId", String(res.body.inventario.inventario_id));
  }
}

assert {
  res.status: eq 201
  res.body.ajuste.tipo: eq ENTRADA
  res.body.inventario.stock_actual: isDefined
}