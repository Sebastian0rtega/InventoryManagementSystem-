meta {
  name: Crear proveedor (ADMIN) -> 201
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/suppliers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Distribuidora Andina Ltda",
    "rut": "76.543.210-K",
    "email": "Ventas@Andina.CL",
    "telefono": "+56955512345"
  }
}

assert {
  res.status: eq 201
  res.body.rut: eq "76543210-K"
  res.body.email: eq "ventas@andina.cl"
  res.body.activo: eq true
}
