meta {
  name: Buscar proveedor por texto -> 200
  type: http
  seq: 3
}

get {
  url: http://localhost:3000/api/suppliers?q=andina&activo=true
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.total: eq 1
  res.body.data[0].nombre: eq "Distribuidora Andina Ltda"
}
