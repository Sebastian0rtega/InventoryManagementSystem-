meta {
  name: Ver usuario propio
  type: http
  seq: 4
}

get {
  url: http://localhost:3000/api/users/{{user_id}}
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.password_hash: not isDefined
}
