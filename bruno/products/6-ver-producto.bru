meta {
  name: Ver producto por ID → 200
  type: http
  seq: 6
}

get {
  url: http://localhost:3000/api/products/1
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.producto_id: isDefined
  res.body.categoria: isDefined
}
