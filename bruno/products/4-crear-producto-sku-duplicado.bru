meta {
  name: Crear producto SKU duplicado → 409
  type: http
  seq: 4
}

post {
  url: http://localhost:3000/api/products
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "categoryId": 1,
    "sku": "TEST-001",
    "name": "Otro producto",
    "purchasePrice": 500,
    "salePrice": 800
  }
}

assert {
  res.status: eq 409
}
