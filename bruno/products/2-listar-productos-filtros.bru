meta {
  name: Listar productos con filtros (search, categoryId, active, sort)
  type: http
  seq: 2
}

get {
  url: http://localhost:3000/api/products?search=leche&categoryId=1&active=true&sort=name
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.items: isArray
}
