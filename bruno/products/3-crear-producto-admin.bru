meta {
  name: Crear producto (ADMIN) → 201
  type: http
  seq: 3
}

post {
  url: http://localhost:3000/api/products
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "categoryId": 1,
    "sku": "TEST-001",
    "name": "Producto de prueba",
    "purchasePrice": 1000,
    "salePrice": 1500
  }
}

assert {
  res.status: eq 201
  res.body.sku: eq "TEST-001"
  res.body.categoria: isDefined
}
