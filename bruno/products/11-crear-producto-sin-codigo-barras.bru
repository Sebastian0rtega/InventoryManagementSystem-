meta {
  name: Crear producto sin código de barras → 201
  type: http
  seq: 11
}

post {
  url: http://localhost:3000/api/products
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "categoryId": 1,
    "sku": "TEST-NO-BARCODE",
    "name": "Producto sin código de barras",
    "purchasePrice": 500,
    "salePrice": 800
  }
}

assert {
  res.status: eq 201
  res.body.sku: eq "TEST-NO-BARCODE"
  res.body.codigo_barras: isNull
}
