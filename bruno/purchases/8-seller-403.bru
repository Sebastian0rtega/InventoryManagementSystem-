meta {
  name: Crear compra como SELLER -> 403
  type: http
  seq: 8
}

post {
  url: http://localhost:3000/api/purchases
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenSeller}}
}

auth:bearer {
  token: {{tokenSeller}}
}

body:json {
  {
    "supplierId": 1,
    "storeId": 1,
    "documentType": "BOLETA",
    "documentNumber": "F-X4",
    "items": [
      { "productId": 1, "quantity": 1, "unitCost": 100 }
    ]
  }
}

assert {
  res.status: eq 403
}
