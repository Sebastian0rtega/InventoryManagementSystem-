meta {
  name: Producto inexistente -> 404
  type: http
  seq: 5
}

post {
  url: http://localhost:3000/api/purchases
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "supplierId": 1,
    "storeId": 1,
    "documentType": "BOLETA",
    "documentNumber": "F-X1",
    "paymentMethod": "EFECTIVO",
    "items": [
      { "productId": 999999, "quantity": 1, "unitCost": 500 }
    ]
  }
}

assert {
  res.status: eq 404
}
