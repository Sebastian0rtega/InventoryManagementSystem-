meta {
  name: Crear compra valida -> 201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/purchases
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "supplierId": 1,
    "storeId": 1,
    "documentType": "FACTURA",
    "documentNumber": "F-{{timestamp}}",
    "paymentMethod": "TRANSFERENCIA",
    "items": [
      { "productId": 1, "quantity": 5, "unitCost": 12000 }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("compraId", String(res.body.compra_id));
    bru.setEnvVar("docNumeroTest", res.body.numero_documento || "");
  }
}

assert {
  res.status: eq 201
  res.body.total: eq "60000.00"
  res.body.tipo_documento: eq "FACTURA"
}
