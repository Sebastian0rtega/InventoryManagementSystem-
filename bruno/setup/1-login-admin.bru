meta {
  name: Login ADMIN (guarda tokenAdmin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@empresa.com",
    "password": "admin_123"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("tokenAdmin", res.body.token);
    bru.setVar("token", res.body.token);
    const u = res.body.usuario;
    if (u && u.id) bru.setEnvVar("userId", String(u.id));
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
  res.body.usuario: not contains password_hash
}
