meta {
  name: Registro valido
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nuevo.vendedor@empresa.com",
    "nombre": "Nuevo Vendedor",
    "password": "clave123"
  }
}

assert {
  res.status: eq 201
  res.body: isNumber 0
}
