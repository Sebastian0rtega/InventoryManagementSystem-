meta {
  name: Email duplicado
  type: http
  seq: 2
}

post {
  url: http://localhost:3000/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nuevo.vendedor@empresa.com",
    "nombre": "Nuevo Vendedor",
    "password": "clave123"
  }
}

assert {
  res.status: eq 409
  res.body.success: eq false
  res.body.error.code: eq CONFLICT
}
