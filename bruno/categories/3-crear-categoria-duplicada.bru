meta {
  name: Crear categoría duplicada → 409
  type: http
  seq: 3
}

post {
  url: http://localhost:3000/api/categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Electrónica"
  }
}

assert {
  res.status: eq 409
}
