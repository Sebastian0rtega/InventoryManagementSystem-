meta {
  name: Ver categoría por ID → 200
  type: http
  seq: 5
}

get {
  url: http://localhost:3000/api/categories/1
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.categoria_id: isDefined
  res.body.nombre: isDefined
}
