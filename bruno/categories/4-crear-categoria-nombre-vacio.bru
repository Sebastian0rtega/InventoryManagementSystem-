meta {
  name: Crear categoría nombre vacío → 422
  type: http
  seq: 4
}

post {
  url: http://localhost:3000/api/categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "   "
  }
}

assert {
  res.status: eq 422
}
