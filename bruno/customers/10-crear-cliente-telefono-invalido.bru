meta {
  name: Crear cliente telefono invalido -> 400
  type: http
  seq: 10
}

post {
  url: http://localhost:3000/api/customers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Cliente Telefono Malo",
    "rut": "16543210-7",
    "email": "telmalo@correo.cl",
    "telefono": "abc123!"
  }
}

assert {
  res.status: eq 400
  res.body.error.code: eq "VALIDATION_ERROR"
}
