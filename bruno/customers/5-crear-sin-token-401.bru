meta {
  name: Crear cliente sin token -> 401
  type: http
  seq: 5
}

post {
  url: http://localhost:3000/api/customers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Anonimo",
    "rut": "12345678-5",
    "email": "anonimo@correo.cl"
  }
}

assert {
  res.status: eq 401
}
