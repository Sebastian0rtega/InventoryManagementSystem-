meta {
  name: Ver cliente inexistente -> 404
  type: http
  seq: 7
}

get {
  url: http://localhost:3000/api/customers/99999
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 404
  res.body.error.code: eq "NOT_FOUND"
}
