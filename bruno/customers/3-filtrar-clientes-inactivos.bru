meta {
  name: Listar clientes filtrando por estado inactivo -> 200
  type: http
  seq: 3
}

get {
  url: http://localhost:3000/api/customers?activo=false
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}
