meta {
  name: Desactivar cliente (ADMIN, soft delete) -> 200
  type: http
  seq: 9
}

delete {
  url: http://localhost:3000/api/customers/{{cliente_id}}
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data.activo: eq false
}
