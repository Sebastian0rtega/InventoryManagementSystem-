meta {
  name: Actualizar cliente -> 200
  type: http
  seq: 8
}

patch {
  url: http://localhost:3000/api/customers/{{cliente_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "telefono": "987654321"
  }
}

assert {
  res.status: eq 200
  res.body.telefono: eq "987654321"
}
