meta {
  name: Desactivar cliente como SELLER -> 403
  type: http
  seq: 6
}

delete {
  url: http://localhost:3000/api/customers/{{cliente_id}}
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token_seller}}
}

auth:bearer {
  token: {{token_seller}}
}

assert {
  res.status: eq 403
}
