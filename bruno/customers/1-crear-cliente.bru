meta {
  name: Crear cliente (ADMIN/SELLER) -> 201
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/customers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Camila   Rojas",
    "rut": "14.234.567-8",
    "email": "Camila@Correo.COM",
    "telefono": "961234567"
  }
}

assert {
  res.status: eq 201
  res.body.nombre: eq "Camila Rojas"
  res.body.rut: eq "14234567-8"
  res.body.email: eq "camila@correo.com"
  res.body.activo: eq true
}

script:post-response {
  if (res.status === 201 && res.body.cliente_id) {
    bru.setVar("cliente_id", res.body.cliente_id);
  }
}
