meta {
  name: Listar clientes con paginacion -> 200
  type: http
  seq: 2
}

get {
  url: http://localhost:3000/api/customers?page=1&limit=5
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data: isDefined
  res.body.limit: eq 5
}
