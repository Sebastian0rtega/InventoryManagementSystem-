meta {
  name: Producto inexistente -> 404
  type: http
  seq: 6
}

post {
  url: http://localhost:3000/api/sales
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "items": [
      { "productId": 999999, "quantity": 1 }
    ]
  }
}

assert {
  res.status: eq 404
  res.body.error.code: eq "NOT_FOUND"
}
