meta {
  name: Ver venta por id -> 200
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/sales/{{ventaId}}
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.venta_id: isDefined
  res.body.detalles: isDefined
}
