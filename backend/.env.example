NODE_ENV=development
PORT=3000

# Local backend runs use localhost; Docker Compose overrides this to "database".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_NAME_TEST=inventory_test_db
DB_USER=inventory_app
DB_PASSWORD=replace_with_a_local_password
ADMIN_PASSWORD=replace_with_a_local_admin_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
