{
  "info": {
    "name": "Inventory Management - Auth",
    "_postman_id": "1a2b3c4d-5e6f-7a8b-9c0d-e1f2a3b4c5d6",
    "description": "Colección de pruebas para el módulo de autenticación del sistema de inventario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/auth"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Registro válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('No devuelve password_hash', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.not.have.property('password_hash');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nuevo.vendedor@empresa.com\",\n  \"nombre\": \"Nuevo Vendedor\",\n  \"password\": \"clave123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["register"]
        }
      },
      "response": []
    },
    {
      "name": "2. Email duplicado",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 409', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test('Usa el formato de error estandarizado', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.error.code).to.eql('CONFLICT');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nuevo.vendedor@empresa.com\",\n  \"nombre\": \"Nuevo Vendedor\",\n  \"password\": \"clave123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["register"]
        }
      },
      "response": []
    },
    {
      "name": "3. Login válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Devuelve un token', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.token).to.be.a('string');",
              "    pm.collectionVariables.set('token', body.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nuevo.vendedor@empresa.com\",\n  \"password\": \"clave123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        }
      },
      "response": []
    },
    {
      "name": "4. Contraseña incorrecta",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nuevo.vendedor@empresa.com\",\n  \"password\": \"contraseña-incorrecta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        }
      },
      "response": []
    },
    {
      "name": "5. /me sin token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/me",
          "host": ["{{baseUrl}}"],
          "path": ["me"]
        }
      },
      "response": []
    },
    {
      "name": "6. /me con token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Devuelve usuario con rol', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.email).to.be.a('string');",
              "    pm.expect(body.rol).to.not.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/me",
          "host": ["{{baseUrl}}"],
          "path": ["me"]
        }
      },
      "response": []
    }
  ]
}
